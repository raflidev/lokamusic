{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
